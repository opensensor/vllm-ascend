#include "kernel_operator.h"

namespace {
constexpr int32_t kTileElements = 1024;
constexpr int32_t kBlocks = 8;
}

extern "C" __global__ __vector__ void round_bf16_fp32(GM_ADDR input, GM_ADDR output, int32_t count)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> input_gm;
    AscendC::GlobalTensor<float> output_gm;
    AscendC::GlobalTensor<uint32_t> input_bits_gm;
    AscendC::GlobalTensor<uint32_t> output_bits_gm;
    input_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(input), count);
    output_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output), count);
    input_bits_gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(input), count);
    output_bits_gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(output), count);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, kTileElements * sizeof(float));
    auto local_float = buffer.Get<float>();
    auto local_bits = local_float.ReinterpretCast<uint32_t>();

    for (int32_t offset = AscendC::GetBlockIdx() * kTileElements; offset < count;
         offset += kBlocks * kTileElements) {
        const int32_t remaining = count - offset;
        const int32_t elements = remaining < kTileElements ? remaining : kTileElements;
        const int32_t aligned = elements & ~7;
        if (aligned > 0) {
            AscendC::DataCopy(local_float, input_gm[offset], aligned);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
            for (int32_t index = 0; index < aligned; ++index) {
                const uint32_t bits = local_bits.GetValue(index);
                const bool is_nan = (bits & 0x7f800000U) == 0x7f800000U && (bits & 0x007fffffU) != 0;
                const uint32_t tie_break = (bits >> 16) & 1U;
                const uint32_t rounded = is_nan ? ((bits & 0x80000000U) | 0x7fc00000U)
                                                : ((bits + 0x7fffU + tie_break) & 0xffff0000U);
                local_bits.SetValue(index, rounded);
            }
            AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
            AscendC::DataCopy(output_gm[offset], local_float, aligned);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
        }
        for (int32_t index = aligned; index < elements; ++index) {
            const uint32_t bits = input_bits_gm.GetValue(offset + index);
            const bool is_nan = (bits & 0x7f800000U) == 0x7f800000U && (bits & 0x007fffffU) != 0;
            const uint32_t tie_break = (bits >> 16) & 1U;
            const uint32_t rounded = is_nan ? ((bits & 0x80000000U) | 0x7fc00000U)
                                            : ((bits + 0x7fffU + tie_break) & 0xffff0000U);
            output_bits_gm.SetValue(offset + index, rounded);
        }
        if (aligned > 0) {
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
    }
}
