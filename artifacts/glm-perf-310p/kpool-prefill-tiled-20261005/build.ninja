ninja_required_version = 1.3
cxx = ccache c++

cflags = -DTORCH_EXTENSION_NAME=glm_kpool_prefill_score_candidate -DTORCH_API_INCLUDE_EXTENSION_H -I/srv/ai/src/glm-l1-wide-build-20261004 -I/srv/ai/venvs/qwen38-w4-test-ce1862/lib/python3.12/site-packages/torch_npu/include -I/usr/local/Ascend/ascend-toolkit/latest/include -isystem /srv/ai/venvs/qwen38-w4-test-ce1862/lib/python3.12/site-packages/torch/include -isystem /srv/ai/venvs/qwen38-w4-test-ce1862/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/python3.12.13/include/python3.12 -fPIC -std=c++20 -O2
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/srv/ai/venvs/qwen38-w4-test-ce1862/lib/python3.12/site-packages/torch_npu/lib -ltorch_npu -L/usr/local/Ascend/ascend-toolkit/latest/lib64 -lascendcl -L/srv/ai/venvs/qwen38-w4-test-ce1862/lib/python3.12/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build bindings.o: compile /home/matteius/experiments/glm-kpool-prefill-tiled-20261005/bindings.cpp
build NPUBridge.o: compile /srv/ai/src/glm-l1-wide-build-20261004/aclnn_torch_adapter/NPUBridge.cpp
build NPUStorageImpl.o: compile /srv/ai/src/glm-l1-wide-build-20261004/aclnn_torch_adapter/NPUStorageImpl.cpp





build glm_kpool_prefill_score_candidate.so: link bindings.o NPUBridge.o NPUStorageImpl.o

default glm_kpool_prefill_score_candidate.so
